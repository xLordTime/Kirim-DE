# Wird beim Setup automatisch als .env angelegt. Nur den Token eintragen.
DISCORD_TOKEN=
KIRIM_LOCALE=de
KIRIM_DATA_DIR=data
# Optional: absoluter Pfad zu einer bestehenden wizdb-Datenbank.
KIRIM_ITEMS_DB=
KIRIM_DECKS_DB=
# Optional: Server-ID zum sofortigen Testen der Slash-Befehle.
DISCORD_GUILD_ID=
KIRIM_SYNC_COMMANDS=true
KIRIM_LOG_LEVEL=INFO
